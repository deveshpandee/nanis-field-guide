<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ cfg.title_en }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..600&family=Kalam:wght@300;400&family=Tiro+Devanagari+Hindi:ital@0;1&display=swap" rel="stylesheet">
<style>
:root {
  color-scheme: light;
  --paper: #f5efe2;
  --paper-edge: #e9e0cc;
  --ink: #2a241f;
  --ink-soft: #6b6157;
  --leaf: #3e5b36;
  --sindoor: #a8471f;
  --rule: #d6cab2;
  --desk: #d9d2c3;
  --serif: "Fraunces", Georgia, serif;
  --deva: "Tiro Devanagari Hindi", "Noto Serif Devanagari", serif;
  --hand: "Kalam", "Tiro Devanagari Hindi", cursive;
}
* { box-sizing: border-box; }
html { background: var(--desk); }
body { margin: 0; padding: 24px 16px 64px; font-family: var(--serif); color: var(--ink); font-size: 15px; line-height: 1.5; font-optical-sizing: auto; }
[lang="hi"] { font-family: var(--deva); }
.page {
  position: relative; width: min(148mm, 100%); min-height: 210mm; margin: 0 auto 28px;
  padding: 14mm 13mm 12mm; background: var(--paper);
  box-shadow: 0 1px 0 var(--paper-edge), 0 12px 30px rgba(60, 45, 20, .18);
  display: flex; flex-direction: column;
}
.toolbar { position: fixed; top: 12px; right: 12px; z-index: 2; }
.toolbar button { font: 500 13px var(--serif); background: var(--ink); color: var(--paper); border: 0; padding: 8px 14px; border-radius: 999px; cursor: pointer; }
.eyebrow { font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-soft); }
h1, h2, h3 { font-weight: 500; margin: 0; }

/* cover */
.cover { justify-content: space-between; text-align: center; }
.cover .title-hi { font-family: var(--deva); font-size: 44px; line-height: 1.25; color: var(--sindoor); margin-top: 6mm; }
.cover .title-en { font-size: 22px; font-style: italic; font-weight: 300; margin-top: 2mm; }
.cover figure { margin: 8mm auto; width: 100%; }
.cover img { width: 100%; max-height: 92mm; object-fit: cover; border-radius: 2px; }
.cover .by { font-size: 14px; color: var(--ink-soft); }
.cover .by strong { color: var(--ink); font-weight: 500; }
.cover .facts { border-top: 1px solid var(--rule); padding-top: 4mm; font-size: 12px; color: var(--ink-soft); }

/* foreword + contents */
.prose p { margin: 0 0 1em; }
.prose h2, .contents h2, .walk h2, .ask-all h2, .colophon h2 { font-size: 24px; margin: 2mm 0 6mm; }
.prose h2 [lang], .contents h2 [lang], .walk h2 [lang], .ask-all h2 [lang] { display: block; font-size: 16px; color: var(--sindoor); }
.contents ol { list-style: none; padding: 0; margin: 0; }
.contents li { display: flex; align-items: baseline; gap: 8px; padding: 2.2mm 0; border-bottom: 1px dotted var(--rule); }
.contents .n { width: 22px; color: var(--ink-soft); font-size: 12px; font-variant-numeric: tabular-nums; }
.contents .hi { font-family: var(--deva); font-size: 18px; }
.contents .en { color: var(--ink-soft); font-size: 13px; margin-left: auto; text-align: right; }

/* plant entry */
.entry .head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4mm; }
.entry .plate { font-size: 12px; letter-spacing: .1em; color: var(--sindoor); font-weight: 600; }
.entry .photos { display: grid; grid-template-columns: 1fr; gap: 2mm; margin: 0 0 5mm; }
.entry .photos.many { grid-template-columns: 2fr 1fr; grid-auto-rows: 1fr; }
.entry .photos img { width: 100%; height: 100%; max-height: 86mm; object-fit: cover; display: block; border-radius: 2px; }
.entry .photos.many img:first-child { grid-row: span 2; }
.entry .photos.many img:not(:first-child) { max-height: 42mm; }
.entry.notes .head .eyebrow { font-family: var(--deva); letter-spacing: 0; text-transform: none; font-size: 14px; }
.entry.notes h3:first-of-type { margin-top: 2mm; }
.entry .name-hi { font-family: var(--deva); font-size: 38px; line-height: 1.15; color: var(--sindoor); }
.entry .name-en { margin-top: 1mm; font-size: 14px; }
.entry .name-en .roman { letter-spacing: .08em; text-transform: uppercase; font-size: 12px; }
.entry .sci { font-style: italic; color: var(--ink-soft); }
.entry .unsure { display: inline-block; margin-top: 2mm; font-size: 11px; color: var(--sindoor); border: 1px solid currentColor; border-radius: 999px; padding: 0 8px; }
.entry blockquote { margin: 6mm 0 0; padding: 0 0 0 8mm; position: relative; }
.entry blockquote::before { content: "“"; position: absolute; left: -1mm; top: -7mm; font-size: 54px; color: var(--leaf); opacity: .5; font-family: var(--serif); }
.entry .quote-hi { font-family: var(--hand); font-size: 19px; line-height: 1.55; margin: 0; }
.entry .quote-en { font-style: italic; font-weight: 300; margin: 2mm 0 0; color: var(--ink); }
.entry audio { width: 100%; height: 32px; margin-top: 3mm; }
.entry h3 { font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--leaf); font-weight: 600; margin: 6mm 0 1.5mm; }
.entry ul { margin: 0; padding-left: 1.1em; }
.entry li { margin: .2em 0; }
.entry .memory { margin: 0; }
.entry .remedy { font-size: 11.5px; color: var(--ink-soft); margin: 2mm 0 0; }
.entry .ask { margin-top: auto; padding-top: 6mm; }
.entry .ask > div { border: 1.5px dashed var(--leaf); border-radius: 4px; padding: 3mm 4mm; }
.entry .ask p { margin: 1mm 0; }
.entry .ask [lang="hi"] { font-family: var(--hand); font-size: 16px; }
.entry .ask .en { font-size: 12.5px; color: var(--ink-soft); }
.entry .basis { font-size: 11px; color: var(--ink-soft); margin: 4mm 0 0; border-top: 1px solid var(--rule); padding-top: 2mm; }

/* walk, questions, colophon */
.walk svg { width: 100%; height: auto; margin: 4mm 0; }
.walk polyline { fill: none; stroke: var(--leaf); stroke-width: 2.5; stroke-dasharray: 2 6; stroke-linecap: round; }
.walk circle { fill: var(--sindoor); }
.walk text { fill: var(--paper); font: 600 11px var(--serif); text-anchor: middle; }
.walk .times { list-style: none; padding: 0; margin: 0; columns: 2; font-size: 13px; }
.walk .times li { padding: 1mm 0; break-inside: avoid; }
.walk .times span { color: var(--ink-soft); font-variant-numeric: tabular-nums; margin-right: 6px; }
.ask-all ol { padding-left: 1.2em; margin: 0; }
.ask-all li { margin-bottom: 4mm; }
.ask-all [lang="hi"] { font-family: var(--hand); font-size: 17px; display: block; }
.ask-all .about { font-size: 11.5px; color: var(--ink-soft); }
.colophon { font-size: 13px; }
.colophon dl { display: grid; grid-template-columns: auto 1fr; gap: 1.5mm 6mm; margin: 0 0 6mm; }
.colophon dt { color: var(--ink-soft); }
.colophon dd { margin: 0; }
.colophon .small { font-size: 11.5px; color: var(--ink-soft); margin-top: auto; }

@media (max-width: 560px) {
  body { padding: 12px 8px 40px; }
  .page { min-height: 0; padding: 22px 18px; }
  .cover .title-hi { font-size: 36px; }
  .entry .name-hi { font-size: 32px; }
}
@page { size: A5; margin: 0; }
@media print {
  html, body { background: var(--paper); padding: 0; }
  .toolbar, audio { display: none !important; }
  .page { width: 148mm; height: 210mm; min-height: 0; margin: 0; box-shadow: none; overflow: hidden; break-after: page; }
  .entry .listen-note { display: block !important; }
}
.listen-note { display: none; font-size: 11px; color: var(--ink-soft); margin-top: 2mm; }
</style>
</head>
<body>
<div class="toolbar"><button type="button" onclick="window.print()">Print / save as PDF</button></div>

<section class="page cover">
  <div>
    <div class="eyebrow">A family field guide</div>
    <h1 class="title-hi" lang="hi">{{ cfg.title_hi }}</h1>
    <div class="title-en">{{ cfg.title_en }}</div>
  </div>
  {% if cover %}<figure><img src="{{ cover.src }}" alt="{{ cfg.cover_alt or 'On the walk' }}"></figure>{% endif %}
  <div>
    <p class="by">The plants{% if cfg.place %} of <strong>{{ cfg.place }}</strong>{% endif %}, as told by <strong>{{ cfg.elder_name or elder }}</strong>{% if cfg.author %}<br>written down by {{ cfg.author }}{% endif %}</p>
    <div class="facts">{{ pages|length }} plants · {{ stats.minutes }} minutes of walking · {{ stats.date }}</div>
  </div>
</section>

{% if cfg.foreword %}
<section class="page prose">
  <h2><span lang="hi">दो शब्द</span>Before we start</h2>
  {% for para in cfg.foreword.strip().split('\n\n') %}<p>{{ para }}</p>{% endfor %}
</section>
{% endif %}

<section class="page contents">
  <h2><span lang="hi">पौधे</span>The plants</h2>
  <ol>
  {% for p in pages %}
    <li><span class="n">{{ '%02d' % loop.index }}</span><span class="hi" lang="hi">{{ p.e.local_name or p.e.english_name }}</span><span class="en">{{ p.e.english_name }}{% if p.e.scientific_name %} · <i>{{ p.e.scientific_name }}</i>{% endif %}</span></li>
  {% endfor %}
  </ol>
</section>

{% for p in pages %}
<section class="page entry" id="stop-{{ p.number }}">
  <div class="head"><span class="plate">No. {{ '%02d' % loop.index }}</span><span class="eyebrow">{{ p.time }}</span></div>
  <div class="photos{% if p.photo_files|length > 1 %} many{% endif %}">
    {% for ph in p.photo_files %}<img src="{{ ph.src }}" alt="{{ p.e.english_name or p.e.local_name }}{% if not loop.first %} (detail){% endif %}">{% endfor %}
  </div>
  <div class="name-hi" lang="hi">{{ p.e.local_name or p.e.english_name }}</div>
  <div class="name-en">
    {% if p.e.local_name_roman %}<span class="roman">{{ p.e.local_name_roman }}</span>{% endif %}
    {% if p.e.english_name and p.e.english_name|lower != (p.e.local_name_roman or '')|lower %} · {{ p.e.english_name }}{% endif %}
    {% if p.e.scientific_name %}<div class="sci">{{ p.e.scientific_name }}</div>{% endif %}
  </div>
  {% if p.e.id_confidence != 'high' %}<span class="unsure">{% if p.e.id_confidence == 'low' %}Not sure yet: ask {{ elder }}{% else %}Probably: check with {{ elder }}{% endif %}</span>{% endif %}

  {% if p.e.quote_hi %}
  <blockquote>
    <p class="quote-hi" lang="hi">{{ p.e.quote_hi }}</p>
    {% if p.e.quote_en %}<p class="quote-en">{{ p.e.quote_en }}</p>{% endif %}
  </blockquote>
  {% endif %}
  {% if p.audio %}
    <audio controls preload="none" src="{{ p.audio.src }}" aria-label="Hear {{ elder }} talk about {{ p.e.english_name or p.e.local_name }}"></audio>
    <div class="listen-note">Hear {{ elder }} say it ({{ p.audio.seconds }} s) in the digital edition.</div>
  {% endif %}
</section>
<section class="page entry notes">
  <div class="head"><span class="plate">No. {{ '%02d' % loop.index }}</span><span class="eyebrow" lang="hi">{{ p.e.local_name or p.e.english_name }}</span></div>

  {% if p.e.teachings %}
  <h3>What {{ elder }} taught</h3>
  <ul>{% for t in p.e.teachings %}<li>{{ t }}</li>{% endfor %}</ul>
  {% endif %}
  {% if p.e.memory %}
  <h3>A memory</h3>
  <p class="memory">{{ p.e.memory }}</p>
  {% endif %}
  {% if p.e.family_remedy %}<p class="remedy">Family knowledge, written down as it was told. Not medical advice.</p>{% endif %}

  {% if p.e.ask_next_time %}
  <div class="ask"><div>
    <div class="eyebrow">Ask {{ elder }} next time</div>
    {% for q in p.e.ask_next_time %}<p lang="hi">{{ q.hi }}</p><p class="en">{{ q.en }}</p>{% endfor %}
  </div></div>
  {% endif %}
  {% if p.e.id_basis %}<p class="basis">How we know: {{ p.e.id_basis }}</p>{% endif %}
</section>
{% endfor %}

<section class="page walk">
  <h2><span lang="hi">सैर</span>The walk</h2>
  {% if route %}{{ route|safe }}{% endif %}
  <ul class="times">
  {% for p in pages %}<li><span>{{ p.time }}</span><span lang="hi">{{ p.e.local_name or p.e.english_name }}</span></li>{% endfor %}
  </ul>
</section>

{% if questions %}
<section class="page ask-all">
  <h2><span lang="hi">अगली सैर के लिए</span>For the next walk</h2>
  <ol>
  {% for p, q in questions %}<li><span lang="hi">{{ q.hi }}</span>{{ q.en }} <span class="about">· {{ p.e.english_name or p.e.local_name }}</span></li>{% endfor %}
  </ol>
</section>
{% endif %}

<section class="page colophon">
  <h2>How this book was made</h2>
  <p>{{ elder }} talked, we walked, and a phone in a pocket recorded it. Everything after that happened on one laptop at home, with no internet: nothing {{ elder }} said was sent anywhere.</p>
  <dl>
    <dt>Listening</dt><dd>{{ stats.whisper }} (open weights) transcribed {{ stats.minutes }} minutes of Hindi</dd>
    <dt>Writing</dt><dd>{{ stats.gemma }} (open weights) wrote {{ pages|length }} entries from {{ stats.photos }} photos</dd>
    <dt>Checking</dt><dd>Every sentence quoted here was checked against the recording{% if stats.dropped %}; {{ stats.dropped }} sentence{{ 's' if stats.dropped != 1 }} Gemma wrote that {{ elder }} never said {{ 'were' if stats.dropped != 1 else 'was' }} removed{% else %}, and all of them are {{ elder }}'s own words{% endif %}</dd>
    <dt>Made</dt><dd>{{ generated }}</dd>
  </dl>
  <p class="small">Plant names come from {{ elder }}; botanical names are Gemma's suggestions and may be wrong. Family remedies are written down as they were told, not as medical advice.</p>
</section>
</body>
</html>
